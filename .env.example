# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mbn_health"

# ── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=4000
WEB_PORT=3000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# ── S3 / Object storage (MinIO locally, S3-compatible in prod) ─────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="mbnhealth"
S3_SECRET_ACCESS_KEY="mbnhealth-secret"
S3_BUCKET="mbn-health-attachments"
S3_FORCE_PATH_STYLE=true

# ── Email (thin integration, disabled by default) ──────────────────────────
EMAIL_PROVIDER="console"     # console | smtp
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="MBN Health <no-reply@mbnhealth.com>"

# ── WhatsApp Business Cloud API (platform-level Meta App credentials) ─────
# Get these from https://developers.facebook.com/apps -> your app -> WhatsApp.
# Per-clinic phone number ID + access token are configured in-app under
# Settings > WhatsApp Bot and stored in the WhatsAppConfig table, not here.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""    # any string you choose; must match the Meta App webhook config
WHATSAPP_APP_SECRET=""              # used to verify the X-Hub-Signature-256 header on incoming webhooks
WHATSAPP_GRAPH_API_VERSION="v21.0"

# ── Cron (protects GET /cron/reminders, which Vercel Cron calls hourly) ────
# Also set this exact value as a Vercel project env var named CRON_SECRET —
# Vercel then automatically sends it as `Authorization: Bearer <value>` on
# its own Cron invocations. Leave empty locally; the route just warns.
CRON_SECRET=""

# ── AI bot (optional; the bot answers "I can't help with that right now"
# and the WhatsApp reminder job still works without this key) ─────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Stripe subscription billing (optional; checkout endpoints return a
# clear error until this is configured) ────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PROFESSIONAL=""
STRIPE_PRICE_ID_ENTERPRISE=""
STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3000/settings?checkout=success"
STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3000/settings?checkout=cancelled"

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Frontend public vars (exposed to browser) ──────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="MBN Health"
