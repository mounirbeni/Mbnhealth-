{
  "name": "mbn-health",
  "version": "0.1.0",
  "private": true,
  "description": "MBN Health - Enterprise SaaS Clinic Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=packages/database",
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/database && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/api && npm run lint --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "prisma:generate": "npm run prisma:generate --workspace=packages/database",
    "prisma:migrate": "npm run prisma:migrate --workspace=packages/database",
    "prisma:seed": "npm run seed --workspace=packages/database",
    "prisma:seed:clinic-directory": "npm run seed:clinic-directory --workspace=packages/database",
    "prisma:studio": "npm run studio --workspace=packages/database"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
