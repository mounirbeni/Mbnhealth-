// MBN Health — Prisma schema
// Multi-tenant clinic management platform.
// Every clinical/business table carries a tenantId for row-level isolation;
// enforcement additionally happens in the NestJS TenantGuard + Prisma middleware.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// TENANCY & SUBSCRIPTION
// ────────────────────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  status       TenantStatus @default(ACTIVE)
  logoUrl      String?
  primaryColor String?      @default("#0EA5E9")
  timezone     String       @default("UTC")
  city         String?
  address      String?
  phone        String?
  email        String?
  website      String?
  settings     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscription      Subscription?
  users             User[]
  roles             Role[]
  departments       Department[]
  doctors           Doctor[]
  patients          Patient[]
  appointments      Appointment[]
  medicalRecords    MedicalRecord[]
  prescriptions     Prescription[]
  invoices          Invoice[]
  payments          Payment[]
  insuranceClaims   InsuranceClaim[]
  labOrders         LabOrder[]
  radiologyOrders   RadiologyOrder[]
  inventoryItems    InventoryItem[]
  notifications     Notification[]
  messageThreads    MessageThread[]
  messageTemplates  MessageTemplate[]
  communicationLogs CommunicationLog[]
  auditLogs         AuditLog[]
  attachments       Attachment[]
  waitlistEntries   WaitlistEntry[]
  refreshTokens     RefreshToken[]
  sessions          Session[]
  whatsAppConfig    WhatsAppConfig?

  @@map("tenants")
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @default(TRIAL)
  status               SubscriptionStatus @default(TRIALING)
  seats                Int                @default(5)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  billingEmail         String?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

// ────────────────────────────────────────────────────────────────────────────
// AUTH, USERS, RBAC
// ────────────────────────────────────────────────────────────────────────────

enum SystemRoleName {
  SUPER_ADMIN
  CLINIC_OWNER
  MANAGER
  RECEPTIONIST
  DOCTOR
  ASSISTANT
  LABORATORY
  RADIOLOGY
  ACCOUNTANT
}

enum Permission {
  SYSTEM_MANAGE_TENANTS
  DASHBOARD_VIEW
  PATIENTS_READ
  PATIENTS_WRITE
  PATIENTS_DELETE
  APPOINTMENTS_READ
  APPOINTMENTS_WRITE
  APPOINTMENTS_DELETE
  DOCTORS_READ
  DOCTORS_WRITE
  DEPARTMENTS_MANAGE
  MEDICAL_RECORDS_READ
  MEDICAL_RECORDS_WRITE
  PRESCRIPTIONS_READ
  PRESCRIPTIONS_WRITE
  LAB_READ
  LAB_WRITE
  RADIOLOGY_READ
  RADIOLOGY_WRITE
  BILLING_READ
  BILLING_WRITE
  INSURANCE_MANAGE
  INVENTORY_READ
  INVENTORY_WRITE
  REPORTS_VIEW
  MESSAGES_READ
  MESSAGES_WRITE
  STAFF_MANAGE
  AUDIT_LOG_VIEW
  SETTINGS_MANAGE
  SUBSCRIPTION_MANAGE
}

model Role {
  id          String          @id @default(cuid())
  tenantId    String?
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  systemRole  SystemRoleName?
  isSystem    Boolean         @default(false)
  permissions Permission[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  users User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id               String    @id @default(cuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  isActive         Boolean   @default(true)
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  mfaRecoveryCodes String[]
  lastLoginAt      DateTime?
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  doctorProfile       Doctor?
  refreshTokens       RefreshToken[]
  sessions            Session[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  createdAppointments Appointment[]  @relation("AppointmentCreatedBy")
  sentMessages        Message[]
  uploadedAttachments Attachment[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Session {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  location     String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Patient portal auth ────────────────────────────────────────────────────
// Patients authenticate separately from staff (no roleId/permissions, no
// tenant-wide access — just their own records), so they get their own
// refresh/reset token tables rather than sharing the staff ones.

model PatientRefreshToken {
  id         String    @id @default(cuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([patientId])
  @@map("patient_refresh_tokens")
}

model PatientPasswordResetToken {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId])
  @@map("patient_password_reset_tokens")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  VIEW_SENSITIVE
}

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ────────────────────────────────────────────────────────────────────────────
// CLINIC STRUCTURE
// ────────────────────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors      Doctor[]
  appointments Appointment[]

  @@unique([tenantId, name])
  @@map("departments")
}

model Doctor {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  specialization  String?
  licenseNumber   String?
  bio             String?
  consultationFee Decimal?    @db.Decimal(10, 2)
  workingHours    Json?
  averageRating   Decimal?    @db.Decimal(3, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
  @@map("doctors")
}

// ────────────────────────────────────────────────────────────────────────────
// PATIENTS / EHR
// ────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

model Patient {
  id                       String        @id @default(cuid())
  tenantId                 String
  tenant                   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mrn                      String
  firstName                String
  lastName                 String
  dob                      DateTime
  gender                   Gender        @default(UNSPECIFIED)
  phone                    String?
  email                    String?
  address                  String?
  bloodType                String?
  avatarUrl                String?
  status                   PatientStatus @default(ACTIVE)
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  insuranceProvider        String?
  insurancePolicyNumber    String?
  notes                    String?
  portalPasswordHash       String?
  portalActivatedAt        DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  allergies           Allergy[]
  medications         Medication[]
  vitals              VitalSign[]
  appointments        Appointment[]
  medicalRecords      MedicalRecord[]
  prescriptions       Prescription[]
  labOrders           LabOrder[]
  radiologyOrders     RadiologyOrder[]
  invoices            Invoice[]
  insuranceClaims     InsuranceClaim[]
  attachments         Attachment[]
  consentForms        ConsentForm[]
  waitlistEntries     WaitlistEntry[]
  communicationLogs   CommunicationLog[]
  portalRefreshTokens PatientRefreshToken[]
  portalResetTokens   PatientPasswordResetToken[]

  @@unique([tenantId, mrn])
  @@index([tenantId, lastName, firstName])
  @@map("patients")
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

model Allergy {
  id        String          @id @default(cuid())
  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  substance String
  reaction  String?
  severity  AllergySeverity @default(MODERATE)
  notedAt   DateTime        @default(now())

  @@map("allergies")
}

model Medication {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  dosage    String?
  frequency String?
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)

  @@map("medications")
}

model VitalSign {
  id                     String   @id @default(cuid())
  patientId              String
  patient                Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedAt             DateTime @default(now())
  temperatureC           Decimal? @db.Decimal(4, 1)
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  respiratoryRate        Int?
  oxygenSaturation       Int?
  weightKg               Decimal? @db.Decimal(5, 2)
  heightCm               Decimal? @db.Decimal(5, 2)
  bmi                    Decimal? @db.Decimal(4, 1)
  recordedById           String?

  @@index([patientId])
  @@map("vital_signs")
}

// ────────────────────────────────────────────────────────────────────────────
// APPOINTMENTS
// ────────────────────────────────────────────────────────────────────────────

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  PROCEDURE
  CHECKUP
  EMERGENCY
  TELEHEALTH
}

enum AppointmentStatus {
  CONFIRMED
  WAITING
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  EMERGENCY
}

model Appointment {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId           String
  patient             Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String
  doctor              Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId        String?
  department          Department?       @relation(fields: [departmentId], references: [id])
  type                AppointmentType   @default(CONSULTATION)
  status              AppointmentStatus @default(CONFIRMED)
  startTime           DateTime
  endTime             DateTime
  reason              String?
  notes               String?
  isRecurring         Boolean           @default(false)
  recurrenceRule      String?
  parentAppointmentId String?
  checkedInAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  reminderSentAt      DateTime?
  createdById         String?
  createdBy           User?             @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  medicalRecord     MedicalRecord?
  labOrders         LabOrder[]
  radiologyOrders   RadiologyOrder[]
  communicationLogs CommunicationLog[]

  @@index([tenantId, startTime])
  @@index([doctorId, startTime])
  @@index([reminderSentAt, startTime])
  @@map("appointments")
}

model WaitlistEntry {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        Doctor?   @relation(fields: [doctorId], references: [id])
  preferredDate DateTime?
  notes         String?
  status        String    @default("WAITING")
  createdAt     DateTime  @default(now())

  @@map("waitlist_entries")
}

// ────────────────────────────────────────────────────────────────────────────
// CLINICAL: MEDICAL RECORDS, PRESCRIPTIONS
// ────────────────────────────────────────────────────────────────────────────

enum MedicalRecordStatus {
  DRAFT
  FINALIZED
  AMENDED
}

model MedicalRecord {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor              @relation(fields: [doctorId], references: [id])
  appointmentId String?             @unique
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id])
  visitDate     DateTime            @default(now())
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  voiceNoteUrl  String?
  aiSummary     String?
  status        MedicalRecordStatus @default(DRAFT)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  diagnoses     Diagnosis[]
  prescriptions Prescription[]

  @@index([tenantId, patientId])
  @@map("medical_records")
}

model Diagnosis {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  icdCode         String?
  description     String
  isPrimary       Boolean       @default(false)

  @@map("diagnoses")
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Prescription {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor             @relation(fields: [doctorId], references: [id])
  medicalRecordId String?
  medicalRecord   MedicalRecord?     @relation(fields: [medicalRecordId], references: [id])
  status          PrescriptionStatus @default(ACTIVE)
  issuedDate      DateTime           @default(now())
  notes           String?
  createdAt       DateTime           @default(now())

  items PrescriptionItem[]

  @@index([tenantId, patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drugName       String
  dosage         String?
  frequency      String?
  duration       String?
  quantity       Int?
  instructions   String?

  @@map("prescription_items")
}

model ConsentForm {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  content      String
  signedAt     DateTime?
  signatureUrl String?
  createdAt    DateTime  @default(now())

  @@map("consent_forms")
}

model Attachment {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String?
  patient       Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileType      String?
  fileSizeBytes Int?
  category      String?
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([tenantId, patientId])
  @@map("attachments")
}

// ────────────────────────────────────────────────────────────────────────────
// LABORATORY / RADIOLOGY (thin, real schema + basic workflow)
// ────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model LabOrder {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  testName      String
  status        OrderStatus  @default(ORDERED)
  orderedAt     DateTime     @default(now())
  completedAt   DateTime?
  resultUrl     String?
  resultNotes   String?

  @@index([tenantId, status])
  @@map("lab_orders")
}

model RadiologyOrder {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  examType      String
  status        OrderStatus  @default(ORDERED)
  orderedAt     DateTime     @default(now())
  completedAt   DateTime?
  resultUrl     String?
  findings      String?

  @@index([tenantId, status])
  @@map("radiology_orders")
}

// ────────────────────────────────────────────────────────────────────────────
// BILLING / INSURANCE
// ────────────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items           InvoiceItem[]
  payments        Payment[]
  insuranceClaims InsuranceClaim[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  serviceType String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  CARD
  INSURANCE
  BANK_TRANSFER
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  transactionRef String?
  paidAt         DateTime      @default(now())
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([tenantId, paidAt])
  @@map("payments")
}

enum InsuranceClaimStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
}

model InsuranceClaim {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?             @relation(fields: [invoiceId], references: [id])
  provider       String
  policyNumber   String?
  claimAmount    Decimal              @db.Decimal(12, 2)
  approvedAmount Decimal?             @db.Decimal(12, 2)
  status         InsuranceClaimStatus @default(SUBMITTED)
  submittedAt    DateTime             @default(now())
  resolvedAt     DateTime?
  notes          String?

  @@index([tenantId, status])
  @@map("insurance_claims")
}

// ────────────────────────────────────────────────────────────────────────────
// INVENTORY (thin)
// ────────────────────────────────────────────────────────────────────────────

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  sku          String?
  category     String?
  quantity     Int      @default(0)
  unit         String?
  reorderLevel Int      @default(0)
  unitCost     Decimal? @db.Decimal(10, 2)
  supplier     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions InventoryTransaction[]

  @@index([tenantId])
  @@map("inventory_items")
}

enum InventoryTransactionType {
  RESTOCK
  CONSUMPTION
  ADJUSTMENT
  WASTE
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  itemId        String
  item          InventoryItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          InventoryTransactionType
  quantity      Int
  reason        String?
  performedById String?
  createdAt     DateTime                 @default(now())

  @@map("inventory_transactions")
}

// ────────────────────────────────────────────────────────────────────────────
// MESSAGING / NOTIFICATIONS (thin)
// ────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model MessageThread {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject   String?
  createdAt DateTime @default(now())

  messages     Message[]
  participants ThreadParticipant[]

  @@map("message_threads")
}

model ThreadParticipant {
  id       String        @id @default(cuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([threadId, userId])
  @@map("thread_participants")
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime      @default(now())

  @@index([threadId])
  @@map("messages")
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

model MessageTemplate {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  channel   CommunicationChannel
  subject   String?
  body      String
  createdAt DateTime             @default(now())

  @@unique([tenantId, name])
  @@map("message_templates")
}

model CommunicationLog {
  id                String                 @id @default(cuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String?
  patient           Patient?               @relation(fields: [patientId], references: [id])
  appointmentId     String?
  appointment       Appointment?           @relation(fields: [appointmentId], references: [id])
  channel           CommunicationChannel
  direction         CommunicationDirection @default(OUTBOUND)
  templateId        String?
  externalContact   String?
  externalMessageId String?
  content           String?
  respondedByAi     Boolean                @default(false)
  status            String                 @default("SENT")
  sentAt            DateTime               @default(now())

  @@index([tenantId, sentAt])
  @@index([appointmentId])
  @@map("communication_logs")
}

// ────────────────────────────────────────────────────────────────────────────
// WHATSAPP BUSINESS INTEGRATION
// ────────────────────────────────────────────────────────────────────────────

model WhatsAppConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumberId      String   @unique
  businessAccountId  String?
  displayPhoneNumber String?
  // Stored as plain text here for simplicity; production deployments should
  // pull this from a secrets manager (see README) rather than the database.
  accessToken        String
  isActive           Boolean  @default(true)
  aiBotEnabled       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("whatsapp_configs")
}
