# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mbn_health"

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=4000
WEB_PORT=3000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# ── S3 / Object storage (MinIO locally, S3-compatible in prod) ─────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="mbnhealth"
S3_SECRET_ACCESS_KEY="mbnhealth-secret"
S3_BUCKET="mbn-health-attachments"
S3_FORCE_PATH_STYLE=true

# ── Messaging providers (thin integrations, disabled by default) ──────────
SMS_PROVIDER="none"          # none | twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

WHATSAPP_PROVIDER="none"     # none | twilio | meta
WHATSAPP_API_TOKEN=""

EMAIL_PROVIDER="console"     # console | smtp
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="MBN Health <no-reply@mbnhealth.com>"

# ── AI (optional; features degrade gracefully if unset) ────────────────────
ANTHROPIC_API_KEY=""

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Frontend public vars (exposed to browser) ──────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="MBN Health"
